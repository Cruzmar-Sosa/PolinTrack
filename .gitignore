# ==============================================================================
# PolinTrack - Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Documentación Interna / Privada (Solicitada por el usuario)
# ------------------------------------------------------------------------------
docs/

# ------------------------------------------------------------------------------
# 2. Variables de Entorno, Claves y Secretos
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
*.env
*.env.*

# Permitir plantillas de variables de entorno (.env.example)
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# Claves criptográficas, certificados y tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 3. Dependencias de Paquetes
# ------------------------------------------------------------------------------
node_modules/
.pnp/
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# 4. Compilaciones y Archivos Generados (Build Outputs)
# ------------------------------------------------------------------------------
dist/
build/
out/
.next/
*.tsbuildinfo
next-env.d.ts.bak

# ------------------------------------------------------------------------------
# 5. Logs y Cachés de Frameworks / Herramientas
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

.cache/
.turbo/
.parcel-cache/
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# 6. Almacenamiento Local, Subidas y Temporales
# ------------------------------------------------------------------------------
.uploads/
uploads/
storage/
temp/
tmp/
scratch/
.gemini/

# Bases de datos locales
*.sqlite
*.sqlite3
*.db-journal

# ------------------------------------------------------------------------------
# 7. Cobertura de Pruebas y Reportes (Testing & Coverage)
# ------------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/

# ------------------------------------------------------------------------------
# 8. Archivos del Sistema Operativo
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 9. Editores e IDEs
# ------------------------------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Visual Studio Code: ignorar estado local pero permitir compartir configs recomendadas
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
