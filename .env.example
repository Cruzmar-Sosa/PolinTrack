# ==============================================================================
# POLINTRACK — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# Canonical reference for all required environment variables across Backend and Frontend.
# NEVER commit real credentials or private keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Private / Server-Side Only)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Database (PostgreSQL 16 on Supabase)
# DATABASE_URL: Connection pooling URL (e.g., PgBouncer transaction mode on port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct database connection URL (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Server-Side API Configuration
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJh..." # Private key with administrative privileges — NEVER expose to client
SUPABASE_JWT_SECRET="your-jwt-secret-here"
SUPABASE_STORAGE_BUCKET="fumigation-certificates" # Private bucket for OIRSA PDFs

# CORS & Client Security
CORS_ORIGINS="http://localhost:3001,https://polintrack.com"

# ------------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Public / Client-Safe)
# ------------------------------------------------------------------------------
# Backend API Base URL
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Supabase Client-Safe Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJh..." # Public anonymous key safe for browser use
