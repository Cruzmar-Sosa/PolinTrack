# Backend Environment Configuration
PORT=3000
NODE_ENV=development

# Database Connections (Supabase PostgreSQL 16)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth & Storage (Private / Server-Side)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJh..."
SUPABASE_JWT_SECRET="your-jwt-secret-here"
SUPABASE_STORAGE_BUCKET="fumigation-certificates"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://polintrack.com"
