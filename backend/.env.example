# Backend Environment Configuration
PORT=3000
NODE_ENV=development

# Database Connections (Supabase PostgreSQL 16 for Prod/Dev; Docker PostgreSQL for QA)
# QA Local: "postgresql://polintrack_admin:[PASSWORD]@127.0.0.1:5433/polintrack_test"
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth & JWT Security Configuration
# ---------------------------------------------------------------------------------------------
# CRITICAL FAIL-FAST (QA-06D-02):
# Autenticación JWT (AuthModule, JwtStrategy, JwtAuthGuard) y Almacenamiento Local (SupabaseStorageService):
# Requieren obligatoriamente SUPABASE_JWT_SECRET o JWT_SECRET (mínimo 16 caracteres).
# En producción: Configurar con el secreto JWT HMAC de su proyecto Supabase (Project Settings > API > JWT Secret).
# En QA local: Definido en backend/.env.test para ejecución aislada sin conexiones cloud.
#
# Storage Modes:
# 1. Cloud Storage Mode:
#    Activado cuando SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY están configurados y no son placeholder.
# 2. Local Storage Mode (Offline / QA / Self-Hosted):
#    Activado cuando SUPABASE_SERVICE_ROLE_KEY es ausente o 'placeholder_service_role_key'.
# ---------------------------------------------------------------------------------------------
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="placeholder_service_role_key"
SUPABASE_JWT_SECRET="min-16-chars-random-jwt-secret-placeholder"
# JWT_SECRET="min-16-chars-optional-local-secret"
# STORAGE_HMAC_SECRET="min-16-chars-optional-local-storage-hmac-secret" # (Opcional) Clave dedicada para firma HMAC de URLs en almacenamiento local
SUPABASE_STORAGE_BUCKET="fumigation-certificates"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://polintrack.com"
